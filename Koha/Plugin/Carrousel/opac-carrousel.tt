[%- TRY %]
    [%- PROCESS "Koha/Plugin/Carrousel/i18n/${lang}.inc" %]
[%- CATCH %]
    [% PROCESS "Koha/Plugin/Carrousel/i18n/default.inc" %]
[%- END %]

<meta charset="utf-8"/>

<div id="inlibro-carrousel">
[% FOREACH carrousel IN carrousels %]
    [% IF carrousel.type == "carrousel" %]
        <div class="carrouselFrame">
            <p class="special-title">[% carrousel.title || carrousel.name | html %]</p>
            <div class="loadingDiv"></div>
            <div id="carrousel-[% loop.index | html %]" class="carrousel">
                <a class="left carousel-control" aria-label="[% T.previous | html %]" tabindex="0">&lsaquo;</a>
                <a class="right carousel-control" aria-label="[% T.next | html %]" tabindex="0">&rsaquo;</a>
                [% FOREACH item IN carrousel.documents %]
                    [% IF carrousel.external %]
                        <a href="[% item.externalUrl | url %][% carrousel.suffix | uri %]" title="[% item.title | html %]"><img class="cloudcarousel" src="[% item.url | url %]" alt="[% item.title | html %]" ></a>
                    [% ELSE %]
                        <a href="/cgi-bin/koha/opac-detail.pl?biblionumber=[% item.biblionumber | uri %][% carrousel.suffix | uri %]" title="[% item.title | html %]"><img class="cloudcarousel" src="[% item.url | url %]" alt="[% item.title | html %]" ></a>
                    [% END %]
                [% END %]
                <div class="carousel-caption">
                    <p class="title-text"></p>
                </div>
            </div>
        </div>
    [% ELSE %]
        [% IF carrousel.type == "scrolling" %]
        <div id="carrousel-[% loop.index | html %]" class="slider">
        [% ELSE %]
        <div id="carrousel-[% loop.index | html %]" class="slider-title">
        [% END %]
            <h2>[% carrousel.title || carrousel.name | html %]</h2>
            [% IF (carrousel.documents.size() > 0) %]
                <div id="[% carrousel.title || carrousel.name | html %]" class="carrousel-viewport">
                    <div class="images">
                        [% FOREACH item IN carrousel.documents %]
                            [% IF carrousel.external %]
                                <a href="[% item.externalUrl | url %][% carrousel.suffix | uri %]" title="[% item.title | html %]"><img class="cloudcarousel" src="[% item.url | url %]" alt="[% item.title | html %]" >[% IF carrousel.type == "scrolling-title" %]<h3>[% item.title | html %]</h3>[% END %]</a>
                            [% ELSE %]
                                <a href="/cgi-bin/koha/opac-detail.pl?biblionumber=[% item.biblionumber | uri %][% carrousel.suffix | uri %]" title="[% item.title | html %]"><img class="cloudcarousel" src="[% item.url | url %]" alt="[% item.title | html %]" >[% IF carrousel.type == "scrolling-title" %]<h3>[% item.title | html %]</h3>[% END %]</a>
                            [% END %]
                        [% END %]
                    </div>
                </div>
                <div class="controls">
                    <button class="[% carrousel.title || carrousel.name | html %]" aria-label="[% T.previous | html %]" style="left: 0;" onclick="Right(this)" type="button">&lt;</button>
                    <button class="[% carrousel.title || carrousel.name | html %]" aria-label="[% T.next | html %]" style="right: 0;" onclick="Left(this)" type="button">&gt;</button>
                </div>
            [% END %]
        </div>
    [% END %]
[% END %]
</div>

<style>
[% UNLESS txtColor %]
   [% txtColor = 'ffffff' %]
[% END %]
[% UNLESS bgColor %]
    [% bgColor = '373737' %]
[% END %]

#inlibro-carrousel .carrouselFrame {
    background: transparent; /* le panneau se fond dans le fond de la section */
    border-radius: 8px;
    margin: 1em 0;
    overflow: visible; /* laisse déborder l'ombre des boutons au survol */
    padding: 1em 0;
    position: relative;
}
/* CloudCarousel pose overflow:hidden en JS sur le conteneur ; on le rouvre pour ne pas
   rogner l'ombre des boutons au survol. Les couvertures restent dans les bornes du cadre. */
#inlibro-carrousel .carrousel { overflow: visible !important; }

#inlibro-carrousel .carrousel{
    height : 300px;
}

/* Voile de chargement rendu transparent : le coverflow n'apparaît plus depuis
   un rectangle blanc (qui jure sur un fond non blanc) mais en fondu d'opacité
   depuis le fond réel de la page (cf. @keyframes nf-carrousel-fadein). */
#inlibro-carrousel .loadingDiv{
    background : transparent;
    position : absolute;
    height : 100%;
    width : 100%;
    z-index : 2000;
    top : 0;
    pointer-events : none;
}

/* Fondu d'apparition du coverflow au chargement : opacité 0 → 1, il émerge donc
   du fond réel (aucune couleur de départ à connaître). Le court délai laisse le
   temps aux couvertures de se positionner avant de devenir visibles. */
@keyframes nf-carrousel-fadein { from { opacity: 0; } to { opacity: 1; } }
#inlibro-carrousel .carrouselFrame .carrousel {
    animation: nf-carrousel-fadein .9s ease .3s both;
}

 /*De bootstrap pour le carrousel*/

.carousel {
    position: relative;
    margin-bottom: 20px;
    line-height: 1;
}

.carousel-inner {
    overflow: hidden;
    width: 100%;
    position: relative;
}

.carousel-inner>.item {
    display: none;
    position: relative;
    -webkit-transition: 0.6s ease-in-out left;
    -moz-transition: 0.6s ease-in-out left;
    -o-transition: 0.6s ease-in-out left;
    transition: 0.6s ease-in-out left;
}

.carousel-inner>.item>img, .carousel-inner>.item>a>img {
    display: block;
    line-height: 1;
}

.carousel-inner>.active, .carousel-inner>.next, .carousel-inner>.prev {
    display: block;
}

.carousel-inner>.active {
    left: 0;
}

.carousel-inner>.next, .carousel-inner>.prev {
    position: absolute;
    top: 0;
    width: 100%;
}

.carousel-inner>.next {
    left: 100%;
}

.carousel-inner>.prev {
    left: -100%;
}

.carousel-inner>.next.left, .carousel-inner>.prev.right {
    left: 0;
}

.carousel-inner>.active.left {
    left: -100%;
}

.carousel-inner>.active.right {
    left: 100%;
}

.carousel-control {
    position: absolute;
    top: 40%;
    left: 15px;
    width: 40px;
    height: 40px;
    margin-top: -20px;
    font-size: 60px;
    font-weight: 100;
    line-height: 28px;
    color: #[%txtColor | html%];
    text-align: center;
    background: #222222;
    border: 2px solid #[%txtColor | html%];
    -webkit-border-radius: 23px;
    -moz-border-radius: 23px;
    border-radius: 23px;
    padding-right: 5px;
    /*opacity: 0.5;*/
    filter: alpha(opacity=50);
}

.carousel-control.right {
    left: auto;
    right: 15px;
    padding-left: 7px;
}

.carousel-control:hover, .carousel-control:focus {
    color: #ffffff;
    text-decoration: none;
    opacity: 0.9;
    filter: alpha(opacity=90);
}

.carousel-indicators {
    position: absolute;
    top: 15px;
    right: 15px;
    z-index: 5;
    margin: 0;
    list-style: none;
}

.carousel-indicators li {
    display: block;
    float: left;
    width: 10px;
    height: 10px;
    margin-left: 5px;
    text-indent: -999px;
    background-color: #ccc;
    background-color: rgba(255, 255, 255, 0.25);
    border-radius: 5px;
}

.carousel-indicators .active {
    background-color: #fff;
}

.carousel-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 15px;
    background: #333333;
    background: rgba(0, 0, 0, 0.75);
}

.carousel-caption h4, .carousel-caption p {
    color: #ffffff;
    line-height: 20px;
}

.carousel-caption h4 {
    margin: 0 0 5px;
}

.carousel-caption p {
    margin-bottom: 0;
}

    /*De bootstrap pour le carrousel FIN*/


#inlibro-carrousel .carousel-caption .title-text{
    color : #[%txtColor | html%];
}

#inlibro-carrousel .carousel-control,
#inlibro-carrousel .carousel-caption{
    background-color : #[%bgColor | html%];
    z-index:500;
    cursor : pointer;
}

#inlibro-carrousel .carousel-caption{
    font-weight : bold;
    position: absolute;
    left: 0;
    right: 0;
}

#inlibro-carrousel .carousel-control,
#inlibro-carrousel .carousel-caption{
    background-color : #[%bgColor | html%];
    z-index:500;
}

#inlibro-carrousel .carousel-caption{
    font-weight : bold;
}

#inlibro-carrousel a.locked{
    width:100px;
}

#inlibro-carrousel .slider, .slider-title {
    overflow: hidden;
    position: relative;
}

#inlibro-carrousel .slider img {
    height: 175px;
}

#inlibro-carrousel .slider-title img {
    height: 175px;
    margin-bottom: 4px;
}

#inlibro-carrousel .slider button {
    position:absolute;
    top: 70%;
    transform: translateY(-70%);
    height:160px
}

#inlibro-carrousel .slider-title button {
    position:absolute;
    top: 58%;
    transform: translateY(-70%);
    height:160px
}

#inlibro-carrousel .special-title{
    text-align: center;
    margin: 0;
    margin-top: 10px;
    margin-bottom: 35px;
    font-weight: bold;
    font-style: normal;
    font-size: 25px;
    color: #[%titleColor | html%];
}

#inlibro-carrousel h2 {
    color: #[%titleColor | html%];
}

#inlibro-carrousel .images {
    left: 0px;
    position: relative;
    white-space: nowrap;

}

#inlibro-carrousel .controls{
    margin-top: 20px;
}

#inlibro-carrousel button{
    color : #[%txtColor | html%];
    background-color: #[%bgColor | html%];
    border: 0;
    height : 2em;
    font-size: 120%;
    border-radius : 3px;
}

#inlibro-carrousel .slider .images a {
    display: inline-block;
    margin-right: 3px;
}

#inlibro-carrousel .slider-title .images a {
    display: inline-grid;
    margin-right: 10px;
}

#inlibro-carrousel .slider-title .images h3 {
    font-size: 0.9em;
    text-wrap: wrap;
    max-width: 100px;
    text-align: left;
}

div.images>a:focus{
    border: 1px solid #[%bgColor | html%];
}

a:focus>img{
    border: 2px solid #[%bgColor | html%];
}

.cloudcarousel {
    max-width: 300px;
    max-height: 160px;
}

.controls button[type="button"] {
    width: auto;
    height: auto;
    margin: 0;
    padding: 0.2em 0.5em;
}

/* ===================================================================== */
/* Finitions rangée paginée (scrolling / scrolling-title)                */
/* Couleurs pilotées par les réglages du plugin : bgColor, txtColor.     */
/* ===================================================================== */

/* Le .slider ne clippe plus (sinon l'ombre des boutons est coupée) ;
   le clip de la rangée passe sur le conteneur intérieur. */
#inlibro-carrousel .slider,
#inlibro-carrousel .slider-title { position: relative; overflow: visible; }
#inlibro-carrousel .slider .carrousel-viewport,
#inlibro-carrousel .slider-title .carrousel-viewport { overflow: hidden; padding: 8px 0; background-color: transparent; }

/* Boutons ronds en "verre teinté" + chevrons SVG centrés (toujours visibles).
   Fond bgColor translucide (alpha 8c ≈ 55 %) + léger flou d'arrière-plan ;
   au survol, le fond devient opaque (voir plus bas). */
#inlibro-carrousel .slider button,
#inlibro-carrousel .slider-title button {
    top: 62%; transform: translateY(-50%); transform-origin: center center;
    height: 44px; width: 44px; border-radius: 50%;
    background-color: #[% bgColor | html %]8c;
    -webkit-backdrop-filter: blur(10px) saturate(140%); backdrop-filter: blur(10px) saturate(140%);
    background-repeat: no-repeat; background-position: center center; background-size: 22px 22px;
    color: transparent; font-size: 0; border: 0; padding: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,.22); opacity: 1;
    transition: background-color .2s, box-shadow .2s; z-index: 600;
}
#inlibro-carrousel .slider button[style*="left"],
#inlibro-carrousel .slider-title button[style*="left"] {
    left: 6px !important; /* !important : bat le style inline left:0 posé par le plugin */
    background-position: calc(50% - 2px) center; /* recentre visuellement le chevron gauche */
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'%23[% txtColor | uri %]'%20stroke-width%3D'3'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Cpath%20d%3D'M15%205%20L8%2012%20L15%2019'%2F%3E%3C%2Fsvg%3E");
}
#inlibro-carrousel .slider button[style*="right"],
#inlibro-carrousel .slider-title button[style*="right"] {
    right: 6px !important; /* !important : bat le style inline right:0 posé par le plugin */
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'%23[% txtColor | uri %]'%20stroke-width%3D'3'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Cpath%20d%3D'M9%205%20L16%2012%20L9%2019'%2F%3E%3C%2Fsvg%3E");
}
#inlibro-carrousel .slider button:hover,
#inlibro-carrousel .slider-title button:hover {
    background-color: #[% bgColor | html %]; /* opaque au survol (plus de transparence), sans agrandissement */
    box-shadow: 0 4px 14px rgba(0,0,0,.30);
}

/* Couvertures : coins arrondis + ombre douce (largeur naturelle) */
#inlibro-carrousel .slider .images a,
#inlibro-carrousel .slider-title .images a { margin-right: 6px; }
#inlibro-carrousel .slider .images img,
#inlibro-carrousel .slider-title .images img { border-radius: 6px; box-shadow: 0 3px 10px rgba(0,0,0,.15); }

/* Plus de séparateur sous le titre : le <hr> a été retiré du markup ; la
   décoration éventuelle sous le titre relève désormais du thème OPAC. */

/* Plus de fondu aux extrémités : le conteneur reste en overflow:hidden (défini
   plus haut), donc la dernière couverture est tronquée par le bord droit — ce
   "peek" signale à lui seul qu'il y a une suite à faire défiler. */

/* Coverflow : bandeau tronqué proprement (pas de décoration sous le titre :
   même logique que les rangées, c'est au thème de la gérer). */
#inlibro-carrousel .carousel-caption .title-text {
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; padding: 0 12px;
}

/* Coverflow : couvertures arrondies + ombre douce (cohérence mode rangée) */
#inlibro-carrousel .carrouselFrame img.cloudcarousel {
    border-radius: 6px; box-shadow: 0 3px 10px rgba(0,0,0,.18);
}

/* Reflet (canvas) : coins hauts arrondis pour épouser le bas de la couverture */
#inlibro-carrousel .carrouselFrame canvas.reflection {
    border-top-left-radius: 6px; border-top-right-radius: 6px;
}

/* Coverflow : barre de titre en pilule flottante (détachée des bords) */
#inlibro-carrousel .carrouselFrame .carousel-caption {
    left: 16px; right: 16px; bottom: 12px;
    border-radius: 10px; padding: 10px 15px;
    box-shadow: 0 3px 12px rgba(0,0,0,.28);
}

/* Coverflow : boutons identiques à ceux des rangées (verre teinté, opaque au survol). */
#inlibro-carrousel .carrouselFrame .carousel-control {
    width: 44px; height: 44px; margin-top: -22px; border-radius: 50%;
    background-color: #[% bgColor | html %]8c; border: 0;
    -webkit-backdrop-filter: blur(10px) saturate(140%); backdrop-filter: blur(10px) saturate(140%);
    color: transparent; font-size: 0;
    background-repeat: no-repeat; background-position: center center; background-size: 22px 22px;
    box-shadow: 0 2px 8px rgba(0,0,0,.22); opacity: 1;
    transition: background-color .2s, box-shadow .2s;
}
#inlibro-carrousel .carrouselFrame .carousel-control.left {
    left: 6px; /* aligné sur les boutons des rangées */
    background-position: calc(50% - 2px) center; /* recentre visuellement le chevron gauche */
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'%23[% txtColor | uri %]'%20stroke-width%3D'3'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Cpath%20d%3D'M15%205%20L8%2012%20L15%2019'%2F%3E%3C%2Fsvg%3E");
}
#inlibro-carrousel .carrouselFrame .carousel-control.right {
    right: 6px; left: auto; /* aligné sur les boutons des rangées */
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'%23[% txtColor | uri %]'%20stroke-width%3D'3'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Cpath%20d%3D'M9%205%20L16%2012%20L9%2019'%2F%3E%3C%2Fsvg%3E");
}
#inlibro-carrousel .carrouselFrame .carousel-control:hover,
#inlibro-carrousel .carrouselFrame .carousel-control:focus {
    background-color: #[% bgColor | html %]; /* opaque au survol, sans agrandissement */
    box-shadow: 0 4px 14px rgba(0,0,0,.30);
}
</style>

<!-- This is the cloud carousel javascript(cloud-carousel.1.0.0.js) -->
<script>
//////////////////////////////////////////////////////////////////////////////////
// CloudCarousel V1.0.5
